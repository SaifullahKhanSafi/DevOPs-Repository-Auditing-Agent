# Copy to .env and fill in your Groq API key. Never commit .env.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Choose a tool-capable model available to your Groq account.
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=120
LLM_MAX_STEPS=48
# Other OpenAI-compatible providers: set LLM_API_KEY and change BASE_URL/MODEL.
# OPENAI_API_KEY and OPENAI_MODEL are also supported.
