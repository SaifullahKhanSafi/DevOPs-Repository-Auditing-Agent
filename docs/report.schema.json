{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevOps repository audit report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "violations"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "category",
          "severity",
          "file",
          "line",
          "description",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "repository hygiene",
              "dependency management",
              "code quality",
              "testing",
              "github actions / ci",
              "security",
              "configuration",
              "collaboration",
              "build and release"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
